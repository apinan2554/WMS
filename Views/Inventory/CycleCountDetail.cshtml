@model WH_Logistic.Models.CycleCount
@{
    ViewData["Title"] = "รายละเอียดนับสต็อก";
}

<h4><i class="bi bi-123"></i> นับสต็อก - @Model.CountNumber</h4>
<p class="text-muted">ตำแหน่ง: @Model.Location?.BinCode | โซน: @Model.Location?.Zone?.ZoneName | สถานะ: @Model.Status</p>

<form method="post" asp-action="SubmitCycleCount">
    <input type="hidden" name="cycleCountId" value="@Model.CycleCountId" />
    <div class="card">
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>สินค้า</th>
                        <th>SKU</th>
                        <th class="text-center">จำนวนในระบบ</th>
                        <th class="text-center">จำนวนนับจริง</th>
                        <th class="text-center">ผลต่าง</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsAdjusted ? (item.Variance != 0 ? "table-warning" : "") : "")">
                            <td>@item.Product?.ProductName</td>
                            <td><code>@item.Product?.SKU</code></td>
                            <td class="text-center">@item.SystemQty</td>
                            <td class="text-center">
                                <input type="hidden" name="countItemIds" value="@item.CountItemId" />
                                @if (Model.Status == WH_Logistic.Models.CycleCountStatus.InProgress)
                                {
                                    <input type="number" name="actualQtys" class="form-control form-control-sm text-center" value="@item.ActualQty" min="0" style="width:80px;margin:auto" />
                                }
                                else
                                {
                                    @item.ActualQty
                                }
                            </td>
                            <td class="text-center">
                                @if (Model.Status == WH_Logistic.Models.CycleCountStatus.Completed)
                                {
                                    var variance = item.Variance;
                                    if (variance > 0)
                                    {
                                        <span class="badge bg-success">+@variance</span>
                                    }
                                    else if (variance < 0)
                                    {
                                        <span class="badge bg-danger">@variance</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">0</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        @if (Model.Status == WH_Logistic.Models.CycleCountStatus.InProgress)
        {
            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> บันทึกผลนับและปรับสต็อก</button>
        }
        <a asp-action="CycleCount" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> กลับ</a>
    </div>
</form>
