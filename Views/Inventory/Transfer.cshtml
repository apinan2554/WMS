@{
    ViewData["Title"] = "ย้ายสต็อก (Stock Transfer)";
    var products = ViewBag.Products as List<WH_Logistic.Models.ProductMaster>;
    var locations = ViewBag.Locations as List<WH_Logistic.Models.Location>;
    var transfers = ViewBag.Transfers as List<WH_Logistic.Models.StockTransfer>;
}

<h4><i class="bi bi-arrow-left-right"></i> ย้ายตำแหน่งสินค้า (Stock Transfer)</h4>

<div class="card mb-4">
    <div class="card-body">
        <form method="post" asp-action="Transfer" id="transferForm">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">สินค้า</label>
                    <select name="productId" id="productSelect" class="form-select" required onchange="loadFromLocations()">
                        <option value="">-- เลือกสินค้า --</option>
                        @if (products != null)
                        {
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductId" data-category="@p.CategoryId">@p.SKU - @p.ProductName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">ตำแหน่งต้นทาง</label>
                    <select name="fromLocationId" id="fromLocation" class="form-select" required>
                        <option value="">-- เลือกสินค้าก่อน --</option>
                    </select>
                    <small id="noStockMsg" class="text-danger" style="display:none;">
                        <i class="bi bi-exclamation-circle"></i> สินค้านี้ยังไม่มีสต็อกในคลัง ต้องรับสินค้าเข้า (Inbound) ก่อน
                    </small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">ตำแหน่งปลายทาง</label>
                    <select name="toLocationId" class="form-select" required>
                        <option value="">-- เลือกตำแหน่ง --</option>
                        @if (locations != null)
                        {
                            @foreach (var l in locations)
                            {
                                <option value="@l.LocationId">@l.BinCode (@l.Zone?.ZoneName)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">จำนวน</label>
                    <input type="number" name="quantity" class="form-control" min="1" required />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-left-right"></i> ย้ายสต็อก</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-clock-history"></i> ประวัติการย้ายล่าสุด</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>เลขที่</th>
                    <th>สินค้า</th>
                    <th>จาก</th>
                    <th>ไป</th>
                    <th>จำนวน</th>
                    <th>วันที่</th>
                    <th>ผู้ดำเนินการ</th>
                </tr>
            </thead>
            <tbody>
                @if (transfers != null)
                {
                    @foreach (var t in transfers)
                    {
                        <tr>
                            <td><code>@t.TransferNumber</code></td>
                            <td>@t.Product?.ProductName</td>
                            <td><span class="badge bg-secondary">@t.FromLocation?.BinCode</span></td>
                            <td><span class="badge bg-primary">@t.ToLocation?.BinCode</span></td>
                            <td>@t.Quantity</td>
                            <td>@t.TransferDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@t.TransferBy?.FullName</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function loadFromLocations() {
    const productId = document.getElementById('productSelect').value;
    const sel = document.getElementById('fromLocation');
    const msg = document.getElementById('noStockMsg');
    if (!productId) {
        sel.innerHTML = '<option value="">-- เลือกสินค้าก่อน --</option>';
        if (msg) msg.style.display = 'none';
        return;
    }
    fetch('/Inventory/GetBalancesByProduct?productId=' + productId)
        .then(r => r.json())
        .then(data => {
            sel.innerHTML = '<option value="">-- เลือกตำแหน่ง --</option>';
            if (data.length === 0) {
                sel.innerHTML = '<option value="">-- ไม่มีสต็อกสินค้านี้ --</option>';
                if (msg) msg.style.display = 'block';
            } else {
                if (msg) msg.style.display = 'none';
                data.forEach(b => {
                    sel.innerHTML += `<option value="${b.locationId}">${b.binCode} (${b.zoneName}) - คงเหลือ: ${b.quantity}</option>`;
                });
            }
        });
}
</script>
}
