<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WH Logistic WMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var role = Context.Session.GetString("Role") ?? "";
        var fullName = Context.Session.GetString("FullName") ?? "";
        var isAdmin = role == "Admin";
        var isWarehouse = role == "WarehouseStaff";
        var isTransport = role == "TransportStaff";
        var isInbound = role == "InboundStaff";
        var isOutbound = role == "OutboundStaff";
        var isManager = role == "FactoryManager";
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/Dashboard">
                <i class="bi bi-box-seam"></i> Warehouse Management Controls
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    @if (isAdmin || isManager)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-box-seam"></i> สินค้า
                            </a>
                        </li>
                    }

                    @if (isAdmin || isWarehouse || isInbound || isManager)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inbound" asp-action="Index">
                                <i class="bi bi-box-arrow-in-down"></i> รับสินค้า
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-clipboard-data"></i> สต็อก
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Transfer">ย้ายสต็อก</a></li>
                                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="CycleCount">นับสต็อก</a></li>
                            </ul>
                        </li>
                    }

                    @if (isAdmin || isWarehouse || isTransport || isOutbound || isManager)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Outbound" asp-action="Index">
                                <i class="bi bi-box-arrow-up"></i> จ่ายสินค้า
                            </a>
                        </li>
                    }

                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="User" asp-action="Index">
                                <i class="bi bi-people"></i> ผู้ใช้
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @fullName
                            @switch (role)
                            {
                                case "Admin":
                                    <span class="badge bg-danger">Admin</span>
                                    break;
                                case "FactoryManager":
                                    <span class="badge" style="background-color:#6f42c1!important;">ผจก.</span>
                                    break;
                                case "InboundStaff":
                                    <span class="badge bg-success">รับเข้า</span>
                                    break;
                                case "OutboundStaff":
                                    <span class="badge bg-info">จ่ายออก</span>
                                    break;
                                case "WarehouseStaff":
                                    <span class="badge bg-info">คลัง</span>
                                    break;
                                case "TransportStaff":
                                    <span class="badge bg-warning text-dark">ขนส่ง</span>
                                    break;
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted small">บทบาท: @role</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.3.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
