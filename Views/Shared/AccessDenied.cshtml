@{
    ViewData["Title"] = "ไม่มีสิทธิ์เข้าถึง";
}

<div class="text-center py-5">
    <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
    <h3 class="mt-3 text-danger">ไม่มีสิทธิ์เข้าถึง</h3>
    <p class="text-muted">คุณไม่มีสิทธิ์ในการเข้าถึงหน้านี้ กรุณาติดต่อผู้ดูแลระบบ</p>
    <p>
        <span class="badge bg-secondary">บทบาทปัจจุบัน: @Context.Session.GetString("Role")</span>
    </p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house"></i> กลับหน้าหลัก
    </a>
</div>
