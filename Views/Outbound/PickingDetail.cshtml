@model WH_Logistic.Models.PickingList
@{
    ViewData["Title"] = "Picking List";
}

<h4><i class="bi bi-list-task"></i> Picking List - @Model.PickingNumber</h4>
<p class="text-muted">
    ออเดอร์: @Model.SalesOrder?.OrderNumber | สถานะ: @Model.Status
    <br/>
    <small class="text-info"><i class="bi bi-info-circle"></i> รายการเรียงตามลำดับ Location สำหรับเส้นทางเดินหยิบที่สั้นที่สุด</small>
</p>

<form method="post" asp-action="ConfirmPicking">
    <input type="hidden" name="pickingId" value="@Model.PickingId" />

    <div class="card">
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">#</th>
                        <th>ตำแหน่ง</th>
                        <th>โซน</th>
                        <th>สินค้า</th>
                        <th class="text-center">จำนวนที่ต้องหยิบ</th>
                        <th class="text-center">จำนวนที่หยิบได้</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.OrderBy(i => i.SortOrder))
                    {
                        <tr>
                            <td class="text-center">@item.SortOrder</td>
                            <td><span class="badge bg-dark fs-6">@item.Location?.BinCode</span></td>
                            <td>@item.Location?.Zone?.ZoneName</td>
                            <td>@item.Product?.ProductName<br/><code>@item.Product?.SKU</code></td>
                            <td class="text-center fw-bold">@item.RequiredQty</td>
                            <td class="text-center">
                                <input type="hidden" name="pickingItemIds" value="@item.PickingItemId" />
                                @if (Model.Status == WH_Logistic.Models.PickingStatus.Pending || Model.Status == WH_Logistic.Models.PickingStatus.InProgress)
                                {
                                    <input type="number" name="pickedQtys" class="form-control form-control-sm text-center" value="@item.RequiredQty" min="0" max="@item.RequiredQty" style="width:80px;margin:auto" />
                                }
                                else
                                {
                                    @item.PickedQty
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        @if (Model.Status == WH_Logistic.Models.PickingStatus.Pending || Model.Status == WH_Logistic.Models.PickingStatus.InProgress)
        {
            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> ยืนยันการหยิบสินค้า</button>
        }
        <a asp-controller="Outbound" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> กลับ</a>
    </div>
</form>
