@{
    ViewData["Title"] = "เพิ่มผู้ใช้ใหม่";
}

<h4><i class="bi bi-person-plus"></i> เพิ่มผู้ใช้ใหม่</h4>

<form method="post" asp-action="Create">
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">ชื่อผู้ใช้ <span class="text-danger">*</span></label>
                    <input type="text" name="Username" class="form-control" required placeholder="username" />
                    <span class="text-danger">@Html.ValidationMessage("Username")</span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">รหัสผ่าน <span class="text-danger">*</span></label>
                    <input type="password" name="PasswordHash" class="form-control" required placeholder="รหัสผ่าน" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">ชื่อ-นามสกุล <span class="text-danger">*</span></label>
                    <input type="text" name="FullName" class="form-control" required placeholder="ชื่อ-นามสกุล" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">บทบาท <span class="text-danger">*</span></label>
                    <select name="Role" class="form-select" required>
                        <option value="@WH_Logistic.Models.UserRole.Admin">Admin - เข้าถึงทุกโมดูล + จัดการผู้ใช้</option>
                        <option value="@WH_Logistic.Models.UserRole.FactoryManager">ผู้จัดการโรงงาน - เห็นทุกอย่างยกเว้นจัดการผู้ใช้</option>
                        <option value="@WH_Logistic.Models.UserRole.InboundStaff">ผู้รับงานเข้าคลัง - รับสินค้า, สต็อก, Dashboard</option>
                        <option value="@WH_Logistic.Models.UserRole.OutboundStaff">ผู้จ่ายงานออกคลัง - จ่ายสินค้า, Dashboard</option>
                        <option value="@WH_Logistic.Models.UserRole.WarehouseStaff" selected>พนักงานคลัง - รับสินค้า, สต็อก, จ่ายสินค้า</option>
                        <option value="@WH_Logistic.Models.UserRole.TransportStaff">พนักงานขนส่ง - จ่ายสินค้า, Dashboard</option>
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <h6>สิทธิ์การเข้าถึงตามบทบาท:</h6>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>โมดูล</th>
                            <th class="text-center">Admin</th>
                            <th class="text-center">ผู้จัดการ</th>
                            <th class="text-center">รับงานเข้า</th>
                            <th class="text-center">จ่ายงานออก</th>
                            <th class="text-center">พนักงานคลัง</th>
                            <th class="text-center">พนักงานขนส่ง</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Dashboard</td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                        </tr>
                        <tr>
                            <td>จัดการสินค้า (Master Data)</td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                        </tr>
                        <tr>
                            <td>รับสินค้า (Inbound)</td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                        </tr>
                        <tr>
                            <td>สต็อก (Inventory)</td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                        </tr>
                        <tr>
                            <td>จ่ายสินค้า (Outbound)</td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                        </tr>
                        <tr>
                            <td>จัดการผู้ใช้</td>
                            <td class="text-center text-success"><i class="bi bi-check-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                            <td class="text-center text-danger"><i class="bi bi-x-circle-fill"></i></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> บันทึก</button>
        <a asp-action="Index" class="btn btn-secondary">ยกเลิก</a>
    </div>
</form>
