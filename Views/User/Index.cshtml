@model List<WH_Logistic.Models.AppUser>
@{
    ViewData["Title"] = "จัดการผู้ใช้งาน";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-people"></i> จัดการผู้ใช้งาน</h4>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-person-plus"></i> เพิ่มผู้ใช้ใหม่</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ชื่อผู้ใช้</th>
                    <th>ชื่อ-นามสกุล</th>
                    <th>บทบาท</th>
                    <th>สิทธิ์การเข้าถึง</th>
                    <th>สถานะ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(!u.IsActive ? "table-secondary" : "")">
                        <td><code>@u.Username</code></td>
                        <td>@u.FullName</td>
                        <td>
                            @switch (u.Role)
                            {
                                case WH_Logistic.Models.UserRole.Admin:
                                    <span class="badge bg-danger">Admin</span>
                                    break;
                                case WH_Logistic.Models.UserRole.FactoryManager:
                                    <span class="badge bg-purple" style="background-color:#6f42c1!important;">ผู้จัดการโรงงาน</span>
                                    break;
                                case WH_Logistic.Models.UserRole.InboundStaff:
                                    <span class="badge bg-success">ผู้รับงานเข้าคลัง</span>
                                    break;
                                case WH_Logistic.Models.UserRole.OutboundStaff:
                                    <span class="badge bg-info">ผู้จ่ายงานออกคลัง</span>
                                    break;
                                case WH_Logistic.Models.UserRole.WarehouseStaff:
                                    <span class="badge bg-primary">พนักงานคลัง</span>
                                    break;
                                case WH_Logistic.Models.UserRole.TransportStaff:
                                    <span class="badge bg-warning text-dark">พนักงานขนส่ง</span>
                                    break;
                            }
                        </td>
                        <td>
                            @switch (u.Role)
                            {
                                case WH_Logistic.Models.UserRole.Admin:
                                    <small>ทุกโมดูล + จัดการผู้ใช้</small>
                                    break;
                                case WH_Logistic.Models.UserRole.FactoryManager:
                                    <small>ทุกโมดูล ยกเว้นจัดการผู้ใช้</small>
                                    break;
                                case WH_Logistic.Models.UserRole.InboundStaff:
                                    <small>รับสินค้า, สต็อก, Dashboard</small>
                                    break;
                                case WH_Logistic.Models.UserRole.OutboundStaff:
                                    <small>จ่ายสินค้า, Dashboard</small>
                                    break;
                                case WH_Logistic.Models.UserRole.WarehouseStaff:
                                    <small>รับสินค้า, สต็อก, จ่ายสินค้า, Dashboard</small>
                                    break;
                                case WH_Logistic.Models.UserRole.TransportStaff:
                                    <small>จ่ายสินค้า, Dashboard</small>
                                    break;
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">ใช้งาน</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ปิดใช้งาน</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form method="post" asp-action="ToggleActive" asp-route-id="@u.UserId" class="d-inline">
                                @if (u.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="ปิดใช้งาน"><i class="bi bi-person-x"></i></button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="เปิดใช้งาน"><i class="bi bi-person-check"></i></button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
